# App configuration
# Local development uses the default Next.js port: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public configuration.
# These values are the standard browser-safe settings for a session-aware client and RLS-protected access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Demo fixtures are only for explicit local development work.
NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------------------------------------------------------
# Phase 4 provider setup (configure in local .env.local or deployment secrets)
# -----------------------------------------------------------------------------
# Browser-safe values: these are exposed to the client bundle.
# Cloudflare Turnstile requires a public site key. Keep this value public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server secrets: keep in .env.local or your secret manager. Never add them to chat
# or source control. These values are read only by server-side code.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
RESEND_API_KEY=your-resend-api-key
EMAIL_WORKER_ENABLED=false

# Sender and moderator destinations.
# EMAIL_FROM must use a domain or subdomain that you have verified in Resend.
# EDITOR_NOTIFICATION_EMAIL should be an address you control for moderation alerts.
EMAIL_FROM="MCPlist <noreply@your-domain.example>"
EDITOR_NOTIFICATION_EMAIL="editor@your-domain.example"

# Turnstile setup notes:
# - The current app loads the widget from https://challenges.cloudflare.com/turnstile/v0/api.js.
# - The page renders two widget instances on the same form screen, but both use the same
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY value. This is one site key shared by the submission and
#   issue-report forms; it is not a separate key per form.
# - Add localhost (and any staging/production hostname you use) to the Turnstile allowlist.
# - Use the public site key in browser code and the secret key only in server-side verification.
#
# Resend setup notes:
# - Configure a verified domain or subdomain in Resend before sending from EMAIL_FROM.
# - The app currently sends directly through Resend from server-side code; there is no separate
#   persistent queue or retry worker in the repo at this stage.
# - Development/testing should use a controlled address you own and a verified sender domain.
# - Keep Phase 4 marked as awaiting live-provider verification until a real submission/email run
#   is completed with configured provider values.
