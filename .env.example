# App configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public configuration.
# These values are the standard browser-safe settings for a session-aware client and RLS-protected access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Optional admin-only locally configured bootstrap flag.
NEXT_PUBLIC_DEMO_MODE=true
